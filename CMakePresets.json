{
  "version": 3,
  "configurePresets": [
    {
      "name": "dos-watcom",
      "displayName": "DOS (Watcom WMake, I86)",
      "generator": "Watcom WMake",
      "binaryDir": "${sourceDir}/build",
      "environment": {
        "PATH": "C:\\WATCOM\\BINNT64;C:\\WATCOM\\BINNT;$penv{PATH}",
        "INCLUDE": "C:\\WATCOM\\H",
        "WATCOM": "C:\\WATCOM",
        "EDPATH": "C:\\WATCOM\\EDDAT",
        "WHTMLHELP": "C:\\WATCOM\\BINNT\\HELP",
        "WIPFC": "C:\\WATCOM\\WIPFC"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:\\WATCOM\\BINNT64\\wcl.exe",
        "CMAKE_CXX_COMPILER": "C:\\WATCOM\\BINNT64\\wcl.exe",
        "CMAKE_LINKER": "C:\\WATCOM\\BINNT64\\wlink.exe",
        "CMAKE_COMPILE_WARNING_AS_ERROR": true,
        "CMAKE_C_FLAGS": "-bt=dos -ml -ox",
        "CMAKE_CXX_FLAGS": "-bt=dos -xs -ml -ox",
        "CMAKE_EXE_LINKER_FLAGS": "system dos",
        "CMAKE_SYSTEM_NAME": "DOS",
        "CMAKE_SYSTEM_PROCESSOR": "I86"
      }
    }
  ]
}
